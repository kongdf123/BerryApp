<Window x:Class="BerryApp.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BerryApp.WPF"
        mc:Ignorable="d"
        Title="Machine Control" Height="600" Width="1000">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#2C3E50">
            <TextBlock Text="MES System" FontSize="20" Foreground="White" FontWeight="Bold" Margin="10"></TextBlock>
            <Button Content="Dashboard" Margin="10" Command="{Binding ShowDashboardCommand}"></Button>
            <Button Content="Orders" Margin="10" Command="{Binding ShowOrdersCommand}"></Button>
            <Button Content="Alarms" Margin="10" Command="{Binding ShowAlarmsCommand}"></Button>
        </StackPanel>
        
        <!-- Main Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"></ContentControl>
        
        <!--<StackPanel>
            <TextBlock Text="Machine Status" FontSize="18"></TextBlock>
            <TextBlock Text="{Binding StatusMessage}" FontSize="24" FontWeight="Bold"  Margin="0,10,0,20"></TextBlock>

            <TextBlock Text="Temperature (°C)" FontSize="18"></TextBlock>

            <TextBlock Text="{Binding Temperature}" FontSize="24" FontWeight="Bold" Foreground="OrangeRed" Margin="0,10,0,0"></TextBlock>
        </StackPanel>-->

