        <Button Content="Load Data" Command="{Binding LoadCommand}" Margin="0,0,0,10"></Button>
        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,0,10"></Button>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="20"></ProgressBar>

        <TextBlock Text="{Binding Progress}" Margin="0,10,0,0"></TextBlock>
    </StackPanel>-->
